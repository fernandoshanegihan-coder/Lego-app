# Rebrickable — free account at rebrickable.com, token at rebrickable.com/api/
REBRICKABLE_API_KEY=

# Google Gemini — free key at aistudio.google.com/apikey (no credit card)
GEMINI_API_KEY=

# OpenRouter — optional fallback provider, key at openrouter.ai/keys.
# Only used when Gemini's free tier is congested; without it, nothing changes.
OPENROUTER_API_KEY=
